    <worksheet name='KPI Fulfilment Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#666666' fontsize='10'>Request Fulfilment Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='requests' name='federated.1kisgfk125xfnj1brqpy90pjc5ks' />
          </datasources>
          <datasource-dependencies datasource='federated.1kisgfk125xfnj1brqpy90pjc5ks'>
            <column caption='Fulfilment Rate' datatype='real' default-format='p0%' name='[Calculation_FulfilRate]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [status] = &quot;Fulfilled&quot; THEN 1 ELSE 0 END) / COUNT([id])' />
            </column>
            <column caption='Blood Group' datatype='string' name='[blood_group]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
