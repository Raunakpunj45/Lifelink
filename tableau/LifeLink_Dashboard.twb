            <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_FulfilRate]' derivation='User' name='[usr:Calculation_FulfilRate:qk]' pivot='key' type='quantitative' />
